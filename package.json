{
  "name": "heartbeat-companion",
  "version": "1.5.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node scripts/build-pages-web.mjs",
    "serve:pages": "python3 -m http.server 4173 --directory docs",
    "build:android": "eas build --platform android",
    "lint": "eslint App.tsx src tests --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:pages-hero": "node scripts/build-cyberlover-hero.mjs",
    "verify:debug-now": "node scripts/verify-debug-now-chain.js",
    "verify:debug-trace": "node scripts/verify-debug-trace-export.js",
    "verify:deepseek-config": "node scripts/verify-deepseek-config.js",
    "verify:memory-settings": "node scripts/verify-memory-settings-chain.js",
    "verify:chat-history": "node scripts/verify-chat-history-ordering.js",
    "verify:visual-assets": "node scripts/verify-visual-assets.js && node scripts/verify-character-asset-registry.js",
    "verify:v1.5": "node scripts/verify-v15-companion-studio.js",
    "verify:engineering": "node scripts/verify-engineering-hardening.js",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify:chat-history && npm run verify:debug-now && npm run verify:visual-assets && npm run verify:v1.5 && npm run verify:engineering"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "date-fns": "^3.6.0",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-uuid": "^2.0.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.35.1",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "private": true
}
