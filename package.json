{
  "name": "heartbeat-companion",
  "version": "1.5.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node scripts/build-pages-web.mjs",
    "serve:pages": "python3 -m http.server 4173 --directory docs",
    "build:android": "eas build --platform android",
    "lint": "eslint App.tsx src tests --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:pages-hero": "node scripts/build-cyberlover-hero.mjs",
    "verify:debug-now": "node scripts/verify-debug-now-chain.js",
    "verify:debug-trace": "node scripts/verify-debug-trace-export.js",
    "verify:deepseek-config": "node scripts/verify-deepseek-config.js",
    "verify:memory-settings": "node scripts/verify-memory-settings-chain.js",
    "verify:chat-history": "node scripts/verify-chat-history-ordering.js",
    "verify:visual-assets": "node scripts/verify-visual-assets.js && node scripts/verify-character-asset-registry.js",
    "verify:v1.5": "node scripts/verify-v15-companion-studio.js",
    "verify:engineering": "node scripts/verify-engineering-hardening.js",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify:chat-history && npm run verify:debug-now && npm run verify:visual-assets && npm run verify:v1.5 && npm run verify:engineering"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "date-fns": "^3.6.0",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-uuid": "^2.0.2",
    "react-native-web": "^0.21.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "sharp": "^0.35.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "private": true
}
