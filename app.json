{
  "expo": {
    "name": "心动伴侣",
    "slug": "heartbeat-companion",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bcmp.cyberlover",
      "infoPlist": {
        "NSCameraUsageDescription": "用于视频通话功能"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#241126"
      },
      "package": "com.bcmp.cyberlover",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "用于视频通话功能"
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#241126",
          "enableFullScreenImage_legacy": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b7587128-89d1-4efe-b68e-65579b44149e"
      }
    },
    "owner": "brocademaple"
  }
}
